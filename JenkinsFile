pipeline {
    agent any

    tools {
        jdk 'JDK 17'
        maven 'Maven 3' // Change to gradle if your project uses Gradle
    }

    environment {
        DOCKER_IMAGE = 'spring-boot-app'
        // Define your SonarQube server scanner configuration name from Jenkins Global Tool Configuration
        SCANNER_HOME = tool 'SonarQubeScanner' 
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                // For Maven projects (includes running unit tests needed for code coverage reports)
                sh 'mvn clean package'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                // Use the SonarQube server configuration defined in Jenkins
                withSonarQubeEnv('SonarQubeServer') {
                    // For Maven projects, you can use the built-in Maven plugin goal:
                    sh 'mvn sonar:sonar'
                    
                    /* If you are using the generic SonarQube Scanner instead, use this:
                    sh "${SCANNER_HOME}/bin/sonar-scanner \
                    -Dsonar.projectKey=spring-boot-app \
                    -Dsonar.projectName='Spring Boot App' \
                    -Dsonar.sources=src/main/java \
                    -Dsonar.tests=src/test/java \
                    -Dsonar.java.binaries=target/classes"
                    */
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh "docker build -t ${env.DOCKER_IMAGE}:${env.BUILD_NUMBER} -t ${env.DOCKER_IMAGE}:latest ."
                }
            }
        }

        stage('Deploy Locally') {
            steps {
                sh '''
                    echo "Deploying Spring Boot container locally..."
                    docker ps -q --filter "name=spring-boot-app" | grep -q . && docker stop spring-boot-app && docker rm spring-boot-app || true
                    docker run -d -p 8080:8080 --name spring-boot-app ${DOCKER_IMAGE}:latest
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline executed successfully! Local container is up and running.'
        }
        failure {
            echo 'Pipeline failed. Check the console output for error logs.'
        }
    }
}
