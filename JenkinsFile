pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'spring-boot-app'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                // Relies on Maven installed on the host/agent system PATH
                sh 'mvn clean package'
            }
        }

        tage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQubeServer') { // Ensure this matches your Jenkins SonarQube server name
                    sh 'sonar-scanner \
                    -Dsonar.projectKey=spring-boot-app \
                    -Dsonar.projectName="Spring Boot App" \
                    -Dsonar.sources=src/main/java \
                    -Dsonar.tests=src/test/java \
                    -Dsonar.java.binaries=target/classes'
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                script {
                    sh "docker build -t ${env.DOCKER_IMAGE}:${env.BUILD_NUMBER} -t ${env.DOCKER_IMAGE}:latest ."
                }
            }
        }

        stage('Deploy Locally') {
            steps {
                sh '''
                    echo "Deploying Spring Boot container locally..."
                    docker ps -q --filter "name=spring-boot-app" | grep -q . && docker stop spring-boot-app && docker rm spring-boot-app || true
                    docker run -d -p 8080:8080 --name spring-boot-app ${DOCKER_IMAGE}:latest
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline executed successfully! Local container is up and running.'
        }
        failure {
            echo 'Pipeline failed. Check the console output for error logs.'
        }
    }
}
